<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 260">
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#1a0b37"/>
      <stop offset="50%" stop-color="#0d1b3e"/>
      <stop offset="100%" stop-color="#0f0a2a"/>
    </linearGradient>
    <linearGradient id="grad1" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#818bff"/>
      <stop offset="100%" stop-color="#2935ba"/>
    </linearGradient>
    <linearGradient id="grad2" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#9577cc"/>
      <stop offset="100%" stop-color="#1a0b37"/>
    </linearGradient>
  </defs>

  <!-- Background -->
  <rect width="400" height="260" fill="url(#bg)" rx="12"/>

  <!-- Radar circle -->
  <circle cx="170" cy="110" r="70" fill="none" stroke="#2935ba" stroke-width="0.5" opacity="0.3"/>
  <circle cx="170" cy="110" r="50" fill="none" stroke="#2935ba" stroke-width="0.5" opacity="0.3"/>
  <circle cx="170" cy="110" r="30" fill="none" stroke="#2935ba" stroke-width="0.5" opacity="0.3"/>

  <!-- Radar spokes -->
  <line x1="170" y1="40" x2="170" y2="180" stroke="#2935ba" stroke-width="0.3" opacity="0.4"/>
  <line x1="100" y1="110" x2="240" y2="110" stroke="#2935ba" stroke-width="0.3" opacity="0.4"/>
  <line x1="120.5" y1="60.5" x2="219.5" y2="159.5" stroke="#2935ba" stroke-width="0.3" opacity="0.4"/>
  <line x1="120.5" y1="159.5" x2="219.5" y2="60.5" stroke="#2935ba" stroke-width="0.3" opacity="0.4"/>

  <!-- Radar data points connected -->
  <polygon points="170,55 200,80 210,120 185,145 150,140 140,100 155,65" fill="rgba(129,139,255,0.15)" stroke="#818bff" stroke-width="1.5"/>
  <circle cx="170" cy="55" r="3" fill="#818bff"/>
  <circle cx="200" cy="80" r="3" fill="#818bff"/>
  <circle cx="210" cy="120" r="3" fill="#818bff"/>
  <circle cx="185" cy="145" r="3" fill="#818bff"/>
  <circle cx="150" cy="140" r="3" fill="#818bff"/>
  <circle cx="140" cy="100" r="3" fill="#818bff"/>
  <circle cx="155" cy="65" r="3" fill="#818bff"/>

  <!-- Chart bars right side -->
  <rect x="270" y="150" width="14" height="40" rx="2" fill="url(#grad1)" opacity="0.7"/>
  <rect x="290" y="130" width="14" height="60" rx="2" fill="url(#grad1)" opacity="0.7"/>
  <rect x="310" y="145" width="14" height="45" rx="2" fill="url(#grad1)" opacity="0.7"/>
  <rect x="330" y="110" width="14" height="80" rx="2" fill="url(#grad1)" opacity="0.7"/>
  <rect x="350" y="140" width="14" height="50" rx="2" fill="url(#grad1)" opacity="0.7"/>

  <!-- Small grid lines for chart -->
  <line x1="265" y1="150" x2="365" y2="150" stroke="#2935ba" stroke-width="0.3" opacity="0.3"/>
  <line x1="265" y1="130" x2="365" y2="130" stroke="#2935ba" stroke-width="0.3" opacity="0.3"/>
  <line x1="265" y1="110" x2="365" y2="110" stroke="#2935ba" stroke-width="0.3" opacity="0.3"/>

  <!-- Graph line top -->
  <polyline points="270,95 290,85 310,90 330,75 350,82" fill="none" stroke="#61dafb" stroke-width="1.5" opacity="0.8"/>
  <circle cx="270" cy="95" r="2.5" fill="#61dafb"/>
  <circle cx="290" cy="85" r="2.5" fill="#61dafb"/>
  <circle cx="310" cy="90" r="2.5" fill="#61dafb"/>
  <circle cx="330" cy="75" r="2.5" fill="#61dafb"/>
  <circle cx="350" cy="82" r="2.5" fill="#61dafb"/>

  <!-- Neo4j-style node dots -->
  <circle cx="80" cy="200" r="5" fill="#9577cc" opacity="0.6"/>
  <circle cx="110" cy="215" r="4" fill="#818bff" opacity="0.6"/>
  <circle cx="145" cy="200" r="5" fill="#9577cc" opacity="0.6"/>
  <circle cx="175" cy="220" r="4" fill="#818bff" opacity="0.6"/>
  <circle cx="205" cy="200" r="5" fill="#9577cc" opacity="0.6"/>
  <circle cx="240" cy="210" r="4" fill="#818bff" opacity="0.6"/>

  <!-- Node connections -->
  <line x1="80" y1="200" x2="110" y2="215" stroke="#2935ba" stroke-width="0.5" opacity="0.4"/>
  <line x1="110" y1="215" x2="145" y2="200" stroke="#2935ba" stroke-width="0.5" opacity="0.4"/>
  <line x1="145" y1="200" x2="175" y2="220" stroke="#2935ba" stroke-width="0.5" opacity="0.4"/>
  <line x1="175" y1="220" x2="205" y2="200" stroke="#2935ba" stroke-width="0.5" opacity="0.4"/>
  <line x1="205" y1="200" x2="240" y2="210" stroke="#2935ba" stroke-width="0.5" opacity="0.4"/>
  <line x1="80" y1="200" x2="175" y2="220" stroke="#2935ba" stroke-width="0.3" opacity="0.2"/>
  <line x1="145" y1="200" x2="240" y2="210" stroke="#2935ba" stroke-width="0.3" opacity="0.2"/>

  <!-- Title -->
  <text x="200" y="26" text-anchor="middle" fill="#9577cc" font-family="sans-serif" font-size="13" font-weight="bold" letter-spacing="2">RADAR AI</text>
</svg>
